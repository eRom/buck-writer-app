# Dockerfile.writing-tools-mcp
# Wraps wdm0006/writing-tools-mcp with a streamable-http transport so it can
# be declared as a remote MCP connector from the OpenAI Responses API.
# Heavy deps (torch, transformers, spacy) — first build is slow (~5 min).

FROM python:3.11-slim AS base
RUN apt-get update && \
    apt-get install -y --no-install-recommends git build-essential wget && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

# Clone upstream at a pinned commit. Bump this hash intentionally after
# reviewing upstream changes.
ARG WTM_REF=main
WORKDIR /opt
RUN git clone --depth=1 --branch ${WTM_REF} https://github.com/wdm0006/writing-tools-mcp /opt/wtm
WORKDIR /opt/wtm

# Sync deps into a local .venv
RUN uv sync

# Pre-install the spaCy small English model (used by passive-voice /
# stylometric analyzers). `spacy download` requires pip which uv-created
# venvs don't ship with — we install the model wheel directly instead.
RUN uv pip install --python .venv/bin/python \
    https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl

# Our HTTP entrypoint: imports the upstream FastMCP instance and runs it with
# streamable-http transport on port 7802.
COPY vps/writing-tools-entrypoint.py /opt/wtm/entrypoint_http.py

# Drop to unprivileged user. uv cache + .venv already materialised under
# /opt/wtm, so ownership transfer is a one-shot.
RUN useradd --system --create-home --uid 1000 wtm && chown -R wtm:wtm /opt/wtm

ENV HOST=0.0.0.0 \
    PORT=7802 \
    PYTHONUNBUFFERED=1

EXPOSE 7802
USER wtm

# HEALTHCHECK : 400 (bad request) is fine — we just want to verify HTTP is up.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget --spider -q http://127.0.0.1:7802/mcp || exit 1

CMD ["uv", "run", "python", "entrypoint_http.py"]
