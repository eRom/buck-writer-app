# Dockerfile.bible-mcp
FROM node:20-alpine AS builder
RUN apk add --no-cache python3 make g++ sqlite
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/bible-mcp/package.json packages/bible-mcp/
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate && \
    pnpm install --frozen-lockfile --filter @buck/bible-mcp...

COPY packages/bible-mcp packages/bible-mcp

RUN pnpm --filter @buck/bible-mcp build

# pnpm deploy bundles the package + all hoisted runtime deps into a flat,
# self-contained directory at /deploy — fixes ERR_MODULE_NOT_FOUND when the
# workspace install hoists deps to the monorepo root.
RUN pnpm deploy --filter @buck/bible-mcp --prod /deploy

FROM node:20-alpine AS runtime
RUN apk add --no-cache sqlite
WORKDIR /app
COPY --from=builder /deploy/dist ./dist
COPY --from=builder /deploy/node_modules ./node_modules
COPY --from=builder /deploy/package.json ./
RUN mkdir -p /app/data && chown -R node:node /app
ENV NODE_ENV=production
EXPOSE 7801
USER node
CMD ["node", "dist/server.js"]
