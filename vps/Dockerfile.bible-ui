# Stage 1 : build SPA
FROM node:20-alpine AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json tsconfig.json ./
COPY packages/bible-ui/package.json ./packages/bible-ui/
RUN pnpm install --frozen-lockfile --filter @buck/bible-ui...

COPY packages/bible-ui ./packages/bible-ui
RUN pnpm -F @buck/bible-ui build

# Stage 2 : rootless nginx — master + workers run as UID 101 (nginx),
# bind on unprivileged port 8080. Caddyfile must target :8080.
FROM nginxinc/nginx-unprivileged:1.27-alpine
# Explicit USER directive (defence-in-depth + satisfies trivy DS-0002 even
# though the upstream image already sets USER nginx/101 by default).
USER nginx
COPY packages/bible-ui/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/packages/bible-ui/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O - http://127.0.0.1:8080/index.html || exit 1
