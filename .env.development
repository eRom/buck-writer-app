# Dev local overrides — versionne, pas de secrets
# Les secrets restent dans .env (gitignore)
DATABASE_URL=file:../../data/buck.db
WORKSPACE_DIR=../../workspace
PUBLIC_BASE_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

WEB_DIST_ROOT=
E2E=1
NODE_ENV=development
LOG_LEVEL=debug
MCP_BIBLE_URL=http://localhost:7801
VITE_BIBLE_UI_URL=http://localhost:5174

BIBLE_DB_PATH=../../data/bible/bible.db
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# MarkItDown sidecar (M6) — run via: docker compose -f vps/compose.local.yml up -d markitdown-worker
MARKITDOWN_URL=http://localhost:8765
MARKITDOWN_INTERNAL_TOKEN=local-dev-token-do-not-use-in-prod
MARKITDOWN_TIMEOUT_MS=65000
