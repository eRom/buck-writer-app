# ── App ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://buck.romain-ecarnot.com

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=file:/app/data/buck.db
WORKSPACE_DIR=/app/workspace
WEB_DIST_ROOT=/app/web-dist

# ── Auth ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_RANDOM

# Comma-separated whitelist (will be lowercased)
AUTH_ALLOWED_EMAILS=romain@example.com,ecrivain@example.com

# ── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=noreply@romain-ecarnot.com

# ── OpenAI (used M1+) ───────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx

# ── MCP Bible (used M4+) ────────────────────────────────────────
MCP_BIBLE_URL=http://bible-mcp:7801
BIBLE_DB_PATH=/app/data/bible.db
BIBLE_HTTP_PORT=7801
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=info
E2E=1

# M5 Memory (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BUCK_USER_ID=
MEMORY_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EDGE_INVOKE_KEY=

# Mettre à true UNIQUEMENT derrière un reverse proxy de confiance (Caddy sur le même VPS)
# qui réécrit X-Forwarded-For avec l'IP réelle. Sinon laisser à false : l'IP utilisée
# pour le rate-limit sera celle du socket TCP (X-Forwarded-For ignoré).
TRUST_PROXY=false

# Optionnel : domaine parent pour le cookie buck_session, utile pour partager
# la session entre sous-domaines (SSO Buck → Bible UI via Caddy forward_auth).
# Laisser vide pour un cookie host-only (dev local).
# Exemple prod : COOKIE_DOMAIN=.romain-ecarnot.com
COOKIE_DOMAIN=

# URL externe de bible-ui (consommée par le card-referentiel de Buck pour ouvrir un nouvel onglet)
VITE_BIBLE_UI_URL=http://localhost:5174
