# ── App ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://buck.romain-ecarnot.com

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=file:/app/data/buck.db
WORKSPACE_DIR=/app/workspace
WEB_DIST_ROOT=/app/web-dist

# ── Auth ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_RANDOM

# Comma-separated whitelist (will be lowercased)
AUTH_ALLOWED_EMAILS=romain@example.com,ecrivain@example.com

# ── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=noreply@romain-ecarnot.com

# ── OpenAI (used M1+) ───────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx

# ── MCP remote connectors (M4+) ────────────────────────────────
# Publicly-reachable HTTPS URLs passed to the OpenAI Responses API as MCP
# connectors. For dev (OpenAI can't reach localhost), keep these as the
# internal Docker hostnames or use a tunnel (ngrok). In prod, Caddy fronts
# them with Bearer auth (MCP_SHARED_SECRET).
MCP_BIBLE_URL=https://bible-mcp.buck.romain-ecarnot.com
MCP_WRITING_TOOLS_URL=https://writing-mcp.buck.romain-ecarnot.com
# Shared Bearer token injected as Authorization header by Buck when passing
# each server to OpenAI, and enforced by Caddy before reverse_proxy.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_SHARED_SECRET=CHANGE_ME_64_HEX_CHARS

BIBLE_DB_PATH=/app/data/bible.db
BIBLE_HTTP_PORT=7801
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=info

# DEV ONLY — enables passwordless /api/__e2e__/dev-login. NEVER set in prod.
# packages/api/src/app.ts refuses to start if E2E=1 && NODE_ENV=production.
# E2E=1

# M5 Memory (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BUCK_USER_ID=
MEMORY_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EDGE_INVOKE_KEY=
# Cosine-similarity floor for recall (0..1). Default 0.5 — raise if Buck
# surfaces off-topic memories, lower (0.3) if legitimate recalls miss.
MEMORY_RECALL_THRESHOLD=0.5

# Mettre à true UNIQUEMENT derrière un reverse proxy de confiance (Caddy sur le même VPS)
# qui réécrit X-Forwarded-For avec l'IP réelle. Sinon laisser à false : l'IP utilisée
# pour le rate-limit sera celle du socket TCP (X-Forwarded-For ignoré).
TRUST_PROXY=false

# Optionnel : domaine parent pour le cookie buck_session, utile pour partager
# la session entre sous-domaines (SSO Buck → Bible UI via Caddy forward_auth).
# Laisser vide pour un cookie host-only (dev local).
# Exemple prod : COOKIE_DOMAIN=.romain-ecarnot.com
COOKIE_DOMAIN=

# URL externe de bible-ui (consommée par le card-referentiel de Buck pour ouvrir un nouvel onglet)
VITE_BIBLE_UI_URL=http://localhost:5174

# --- Realtime (M8) ---
REALTIME_ENABLED=0
