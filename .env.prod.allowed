# Whitelist des keys autorisees a etre synchronisees vers le secret prod sops.
# Toute key absente ici = SILENCIEUSEMENT IGNOREE par scripts/env-sync-to-prod.sh.
# Mettre a jour apres ajout d'une variable d'env runtime cote prod.
#
# Une key par ligne. Les lignes vides et commentaires sont ignores.
#
# Pourquoi : un .env local contient inevitablement des vars dev-only
# (E2E=1, fixtures, surcharge URL localhost) qui sont DANGEREUSES en prod.
# Le serveur api refuse de demarrer si E2E=1 + NODE_ENV=production.
# Cette whitelist materialise le contrat .env -> prod et fait foi.

# Runtime
NODE_ENV
PORT
PUBLIC_BASE_URL
DATABASE_URL
WORKSPACE_DIR
WEB_DIST_ROOT
LOG_LEVEL

# Auth
AUTH_JWT_SECRET
AUTH_ALLOWED_EMAILS
COOKIE_DOMAIN

# Email
RESEND_API_KEY
RESEND_FROM

# OpenAI
OPENAI_API_KEY
OPENAI_EMBEDDING_MODEL

# MCP / Bible
MCP_BIBLE_URL

# Memory (Supabase)
MEMORY_ENABLED
SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY
EDGE_INVOKE_KEY

# Realtime (M8)
REALTIME_ENABLED

# Bible UI SSO
BIBLE_USER
BIBLE_PASSWORD_HASH
VITE_BIBLE_UI_URL

# TTS Gemini (M9)
GEMINI_API_KEY
TTS_ENABLED
TTS_DEFAULT_VOICE
TTS_MAX_CHARS
